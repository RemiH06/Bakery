<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Bakery" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/hoja</item>
        <item name="android:colorPrimary">@color/acento</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/tenue</item>
        <item name="android:textColorHint">@color/tenue</item>
        <item name="android:editTextStyle">@style/Campo</item>
        <item name="android:alertDialogTheme">@style/Aviso</item>
    </style>
    <style name="Aviso" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/hoja</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:textColorPrimary">@color/texto</item>
    </style>
    <style name="Hoja" parent="android:Theme.Material.Dialog.MinWidth">
        <item name="android:windowBackground">@drawable/caja</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/tenue</item>
        <item name="android:textColorHint">@color/tenue</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:editTextStyle">@style/Campo</item>
    </style>
    <style name="Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="Campo" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/campo</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="Titulo">
        <item name="android:textColor">@color/durazno</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Rotulo">
        <item name="android:textColor">@color/tenue</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Boton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/boton</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>
    <style name="BotonTexto" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/acento</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
